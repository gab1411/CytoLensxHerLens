<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ================================================= -->
    <!-- PAGE 1 : EXAMINATION                              -->
    <!-- ================================================= -->

    <ScrollView
        android:id="@+id/pageExamination"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- HEADER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Examination"
                android:textColor="#202124"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Cervix Photos"
                android:textColor="#18A7A7"
                android:textSize="16sp" />

            <!-- GUIDELINE -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let's check this taking picture guideline!"
                        android:textColor="#202124"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="• Follow the camera guide to detect the cervix."
                        android:textColor="#C58B00"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="• Make sure the camera torch is always on."
                        android:textColor="#C58B00"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ================================================= -->
            <!-- BEFORE ACETIC                                     -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Picture Before Acetic Acid"
                android:textColor="#202124"
                android:textSize="20sp"
                android:textStyle="bold" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#F8FAFA"
                app:cardCornerRadius="18dp"
                app:strokeColor="#D9E0E0"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivBeforePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBeforeTakePicture"
                        android:layout_width="190dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:text="Take Picture"
                        android:textColor="#075B63"
                        android:textStyle="bold"
                        app:backgroundTint="#D9F6F5"
                        app:cornerRadius="16dp" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BEFORE ACTIONS -->

            <LinearLayout
                android:id="@+id/layoutBeforeActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeforeGreenFilter"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.25"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Green Filter"
                    android:textAllCaps="false"
                    android:textColor="#228B50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DDF8E8"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeforeCrop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="Crop"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:strokeColor="#D3D8DD"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBeforeRetry"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:strokeColor="#D3D8DD"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- ================================================= -->
            <!-- AFTER ACETIC                                      -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="Picture After Acetic Acid"
                android:textColor="#202124"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#F8FAFA"
                app:cardCornerRadius="18dp"
                app:strokeColor="#D9E0E0"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <ImageView
                        android:id="@+id/ivAfterPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />


                    <LinearLayout
                        android:id="@+id/layoutAfterEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAfterTakePicture"
                            android:layout_width="190dp"
                            android:layout_height="56dp"
                            android:enabled="false"
                            android:text="Take Picture"
                            android:textColor="#075B63"
                            android:textStyle="bold"
                            app:backgroundTint="#D9F6F5"
                            app:cornerRadius="16dp" />

                        <TextView
                            android:id="@+id/tvAfterWarning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:text="Take picture Before Acetic Acid first!"
                            android:textColor="#777777"
                            android:textSize="14sp" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AFTER ACTIONS -->

            <LinearLayout
                android:id="@+id/layoutAfterActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAfterGreenFilter"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.25"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="Green Filter"
                    android:textAllCaps="false"
                    android:textColor="#228B50"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DDF8E8"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAfterCrop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="Crop"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:strokeColor="#D3D8DD"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAfterRetry"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.9"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="#202124"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:strokeColor="#D3D8DD"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- NEXT -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:enabled="false"
                android:text="Next"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#18A7A7"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </ScrollView>

    <!-- ================================================= -->
    <!-- PAGE 2 : LIVE CAMERA                              -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/pageCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:background="#000000"
        android:visibility="gone">

        <!-- CAMERA AREA -->
        <FrameLayout
            android:id="@+id/cameraViewContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="150dp"
            android:layout_gravity="top"
            android:background="#000000"
            android:clipChildren="true"
            android:clipToPadding="true">

        </FrameLayout>

        <!-- TOP PANEL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#AA000000"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCameraBack"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:minWidth="0dp"
                    android:text="←"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    app:backgroundTint="#33000000"
                    app:cornerRadius="26dp"/>

                <TextView
                    android:id="@+id/tvCameraTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Before Acetic Acid"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="52dp"
                    android:layout_height="52dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCameraStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#55333333"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="Camera Connected"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvHardwareStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#55333333"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp"
                    android:text="Hardware: Not Connected"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- BOTTOM CONTROL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Digital Zoom"
                android:textColor="#BBBBBB"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoom1"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:text="1x"
                    app:cornerRadius="22dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoom2"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="2x"
                    app:cornerRadius="22dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoom3"
                    android:layout_width="64dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="3x"
                    app:cornerRadius="22dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGreenFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Green Filter"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="24dp"/>

                <TextView
                    android:id="@+id/tvLedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="LED: --"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCameraTakePicture"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_marginTop="14dp"
                android:text="TAKE PICTURE"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="30dp"/>

        </LinearLayout>

        <View
            android:id="@+id/greenOverlay"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="150dp"
            android:background="#5500FF00"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- ================================================= -->
    <!-- PAGE 3 : REVIEW                                   -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/pageReview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                app:backgroundTint="#33000000"
                app:cornerRadius="26dp" />

            <TextView
                android:id="@+id/tvReviewTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Review Picture"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <View
                android:layout_width="52dp"
                android:layout_height="52dp" />

        </LinearLayout>

        <!-- PHOTO -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#111111">

            <ImageView
                android:id="@+id/ivReviewPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvReviewPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Captured image will appear here"
                android:textColor="#777777"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- REVIEW ACTIONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="Crop"
                android:textColor="#FFFFFF"
                app:backgroundTint="#444444"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetake"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:text="Retake"
                android:textColor="#FFFFFF"
                app:backgroundTint="#444444"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- USE PHOTO -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsePhoto"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:text="Use Photo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#18A7A7"
            app:cornerRadius="16dp" />

    </LinearLayout>

    <!-- ================================================= -->
    <!-- PAGE 4 : AI LOADING                               -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/pageLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="Analyzing Cervix Images"
                android:textColor="#202124"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="HerLens AI is processing the examination..."
                android:textColor="#777777"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- ================================================= -->
    <!-- PAGE 5 : AI UNDER MAINTENANCE                     -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/pageMaintenance"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HerLens AI"
                android:textColor="#18A7A7"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="AI Analysis"
                android:textColor="#202124"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Under Maintenance"
                android:textColor="#777777"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="The AI analysis feature is currently under development."
                android:textColor="#999999"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMaintenanceBack"
                android:layout_width="210dp"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:text="Back to Examination"
                android:textColor="#FFFFFF"
                app:backgroundTint="#18A7A7"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- ================================================= -->
    <!-- USB DEBUG HIDDEN                                  -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/tvDebugStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:text="USB Debug"
        android:visibility="gone" />

</FrameLayout>